# Copy to .env and fill in what you have. .env is git-ignored.
# Each key enables that backend in remote.py; leave the others empty.

TYPESAFE_API_KEY=        # the real Jev — https://typesafe.ai
DEEPSEEK_API_KEY=        # DeepSeek — https://platform.deepseek.com
MOONSHOT_API_KEY=        # Kimi — https://platform.moonshot.ai
OPENROUTER_API_KEY=      # OpenRouter — https://openrouter.ai
OPENAI_API_KEY=          # OpenAI — https://platform.openai.com
AI_GATEWAY_API_KEY=      # Vercel AI Gateway — https://vercel.com/ai-gateway
HF_TOKEN=                # Hugging Face, only for sets behind a login (GPQA) — https://huggingface.co/settings/tokens
LLAMACPP_URL=            # llama-server, default http://localhost:8080/v1/chat/completions

# Anthropic's Messages API returns no token log-probabilities, so it cannot serve as a
# readout backend here; it can only generate text answers.
